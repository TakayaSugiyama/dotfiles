{
  "suggest.enablePreview": true,
  "coc.preferences.formatOnSaveFiletypes": [
    "css",
    "markdown",
    "json",
    "javascript",
    "typescript",
    "ruby",
    "prisma",
    "c"
  ],
  "diagnostic.displayByAle": true,
  "tsserver.log": "normal",
  "languageserver": {
    "dockerfile": {
      "command": "docker-langserver",
      "filetypes": ["dockerfile"],
      "args": ["--stdio"]
    }
  },
  "svelte.enable-ts-plugin": false
}
